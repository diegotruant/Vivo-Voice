# ─── Coach AI ────────────────────────────────────────────────────────────────
# Gli utenti possono inserire la PROPRIA chiave dalle "Impostazioni Coach AI" dell'app
# (resta nel loro browser). Le chiavi qui sotto sono facoltative: se presenti, il server
# le usa per chi non ha configurato una chiave propria (a tuo carico!).
# Senza nessuna chiave il coach mostra solo consigli generici offline.

# Provider predefinito del server: anthropic | gemini | openai
LLM_PROVIDER="anthropic"

# Anthropic Claude (consigliato) — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=""

# Google Gemini — https://aistudio.google.com/apikey (abilita anche la voce sintetica del coach)
GEMINI_API_KEY=""

# OpenAI o servizio compatibile — richiede LLM_MODEL
OPENAI_API_KEY=""
# OPENAI_BASE_URL="https://api.openai.com/v1"

# Modello del server (facoltativo; predefiniti: claude-opus-5-5, gemini-3.8-flash)
# LLM_MODEL=""

# Livello di ragionamento per i modelli Claude 5: low | medium | high | xhigh | max (predefinito: low)
# LLM_EFFORT="low"

# Consenti agli utenti di indicare un URL personalizzato per servizi compatibili OpenAI
# (es. un Ollama locale). Lascia "false" su un server pubblico: rischio SSRF.
ALLOW_CUSTOM_LLM_BASE_URL="false"

# ─── Server ──────────────────────────────────────────────────────────────────
# PORT="3000"
# HOST="0.0.0.0"
# Dietro un reverse proxy imposta il numero di proxy fidati (es. "1") per ottenere l'IP reale del client.
# TRUST_PROXY="1"
# Limite richieste AI per IP: AI_RATE_LIMIT_MAX richieste ogni AI_RATE_LIMIT_WINDOW_SEC secondi
# AI_RATE_LIMIT_MAX="30"
# AI_RATE_LIMIT_WINDOW_SEC="300"
# Più istanze del server? Condividi i contatori dei limiti su Redis:
# REDIS_URL="redis://localhost:6379"
# Tetto giornaliero di richieste fatte con la chiave AI del SERVER (0 = nessun tetto)
# SERVER_KEY_DAILY_LIMIT="200"
# Dimensione massima del corpo JSON (audio in base64)
# JSON_BODY_LIMIT="10mb"

# APP_URL: URL pubblico dell'app (facoltativo)
APP_URL=""
